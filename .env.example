# Copie para .env (nunca commitado) e ajuste. Só valores de desenvolvimento aqui.

# Postgres do docker-compose.yml (porta local 5450)
POSTGRES_USER=fininho_treino
POSTGRES_PASSWORD=dev-apenas-local
POSTGRES_DB=fininho_treino
DATABASE_URL=postgresql://fininho_treino:dev-apenas-local@127.0.0.1:5450/fininho_treino
# Banco dos testes e2e (criado por scripts/postgres-init.sql)
DATABASE_URL_TEST=postgresql://fininho_treino:dev-apenas-local@127.0.0.1:5450/fininho_treino_test

# API (NestJS)
API_PORT=3001
# Segredo do JWT de acesso: gere um valor longo e aleatório (mínimo 32 caracteres)
JWT_ACCESS_SECRET=troque-por-um-valor-aleatorio-de-pelo-menos-32-caracteres

# Web (Next.js): para onde o Next repassa /api
API_INTERNAL_URL=http://127.0.0.1:3001
