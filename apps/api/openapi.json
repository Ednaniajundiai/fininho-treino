  },
  "info": {
    "title": "fininho-treino",
    "description": "API de fichas de treino: contas, acesso, fichas e sessões.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "SaudeDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          }
        },
        "required": [
          "status"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "paula@exemplo.test"
          },
          "senha": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "senha"
        ]
      },
      "Papel": {
        "type": "string",
        "enum": [
          "PROFESSOR",
          "ALUNO"
        ]
      },
      "ContaDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "nome": {
            "type": "string",
            "example": "Paula Prado"
          },
          "email": {
            "type": "string",
            "example": "paula@exemplo.test"
          },
          "papel": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Papel"
              }
            ]
          },
          "senhaProvisoria": {
            "type": "boolean",
            "description": "Verdadeiro enquanto a conta não trocou a senha provisória."
          }
        },
        "required": [
          "id",
          "nome",
          "email",
          "papel",
          "senhaProvisoria"
        ]
      },
      "SessaoDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "JWT de acesso, válido por 15 minutos. Guardar só em memória."
          },
          "usuario": {
            "$ref": "#/components/schemas/ContaDto"
          }
        },
        "required": [
          "accessToken",
          "usuario"
        ]
      },
      "TrocarSenhaDto": {
        "type": "object",
        "properties": {
          "senhaAtual": {
            "type": "string",
            "description": "A senha atual (a provisória, no primeiro acesso)."
          },
          "novaSenha": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          }
        },
        "required": [
          "senhaAtual",
          "novaSenha"
        ]
      },
      "CriarAlunoDto": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string",
            "example": "Ari Alves"
          },
          "email": {
            "type": "string",
            "example": "ari@exemplo.test"
          }
        },
        "required": [
          "nome",
          "email"
        ]
      },
      "AlunoComSenhaProvisoriaDto": {
        "type": "object",
        "properties": {
          "aluno": {
            "$ref": "#/components/schemas/ContaDto"
          },
          "senhaProvisoria": {
            "type": "string",
            "description": "Senha provisória gerada pelo sistema. Mostrada só nesta resposta; não é consultável depois.",
            "example": "abcd-efgh-jkmn"
          }
        },
        "required": [
          "aluno",
          "senhaProvisoria"
        ]
      },
      "Unidade": {
        "type": "string",
        "enum": [
          "repeticoes",
          "segundos"
        ]
      },
      "ExercicioDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "nome": {
            "type": "string",
            "example": "Supino reto"
          },
          "unidadePadrao": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Unidade"
              }
            ]
          },
          "ativo": {
            "type": "boolean",
            "description": "Desativado some das novas escolhas, mas segue nas fichas que o usam."
          }
        },
        "required": [
          "id",
          "nome",
          "unidadePadrao",
          "ativo"
        ]
      },
      "CriarExercicioDto": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string",
            "example": "Supino reto"
          },
          "unidadePadrao": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Unidade"
              }
            ]
          }
        },
        "required": [
          "nome",
          "unidadePadrao"
        ]
      },
      "TipoDeItem": {
        "type": "string",
        "enum": [
          "forca",
          "cardio"
        ]
      },
      "Modalidade": {
        "type": "string",
        "enum": [
          "esteira",
          "bike",
          "escada",
          "livre"
        ],
        "description": "Cardio."
      },
      "ItemFichaEntradaDto": {
        "type": "object",
        "properties": {
          "tipo": {
            "allOf": [
              {
                "$ref": "#/components/schemas/TipoDeItem"
              }
            ]
          },
          "observacao": {
            "type": "string",
            "example": "Cadência lenta na descida"
          },
          "exercicioId": {
            "type": "string",
            "format": "uuid",
            "description": "Força: exercício ativo do catálogo."
          },
          "series": {
            "type": "number",
            "description": "Força: 1 ou mais.",
            "example": 3
          },
          "faixaMin": {
            "type": "number",
            "description": "Força: mínimo da faixa.",
            "example": 8
          },
          "faixaMax": {
            "type": "number",
            "description": "Força: máximo da faixa.",
            "example": 12
          },
          "unidade": {
            "description": "Força.",
            "allOf": [
              {
                "$ref": "#/components/schemas/Unidade"
              }
            ]
          },
          "modalidade": {
            "description": "Cardio.",
            "allOf": [
              {
                "$ref": "#/components/schemas/Modalidade"
              }
            ]
          },
          "duracaoMinMin": {
            "type": "number",
            "description": "Cardio: duração mínima em minutos.",
            "example": 10
          },
          "duracaoMaxMin": {
            "type": "number",
            "description": "Cardio: duração máxima em minutos.",
            "example": 15
          }
        },
        "required": [
          "tipo"
        ]
      },
      "DiaFichaEntradaDto": {
        "type": "object",
        "properties": {
          "titulo": {
            "type": "string",
            "example": "Peito e tríceps"
          },
          "itens": {
            "description": "Na ordem de execução.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ItemFichaEntradaDto"
            }
          }
        },
        "required": [
          "titulo",
          "itens"
        ]
      },
      "CriarFichaDto": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string",
            "example": "Hipertrofia — bloco 1"
          },
          "ativar": {
            "type": "boolean",
            "description": "Verdadeiro cria já ativa (arquiva a ativa anterior); senão nasce rascunho.",
            "default": false
          },
          "dias": {
            "description": "Na ordem da rotação; o rótulo (A, B, C…) vem dessa ordem.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DiaFichaEntradaDto"
            }
          }
        },
        "required": [
          "nome",
          "dias"
        ]
      },
      "StatusDaFicha": {
        "type": "string",
        "enum": [
          "rascunho",
          "ativa",
          "arquivada"
        ]
      },
      "ItemFichaDto": {
        "type": "object",
        "properties": {
          "ordem": {
            "type": "number",
            "example": 1
          },
          "tipo": {
            "allOf": [
              {
                "$ref": "#/components/schemas/TipoDeItem"
              }
            ]
          },
          "observacao": {
            "type": "string"
          },
          "exercicioId": {
            "type": "string",
            "format": "uuid"
          },
          "exercicioNome": {
            "type": "string",
            "description": "Nome do exercício, para quem não vê o catálogo."
          },
          "series": {
            "type": "number"
          },
          "faixaMin": {
            "type": "number"
          },
          "faixaMax": {
            "type": "number"
          },
          "unidade": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Unidade"
              }
            ]
          },
          "modalidade": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Modalidade"
              }
            ]
          },
          "duracaoMinMin": {
            "type": "number"
          },
          "duracaoMaxMin": {
            "type": "number"
          }
        },
        "required": [
          "ordem",
          "tipo"
        ]
      },
      "DiaFichaDto": {
        "type": "object",
        "properties": {
          "rotulo": {
            "type": "string",
            "example": "A"
          },
          "titulo": {
            "type": "string",
            "example": "Peito e tríceps"
          },
          "ordem": {
            "type": "number",
            "example": 1
          },
          "itens": {
            "type": "array",
