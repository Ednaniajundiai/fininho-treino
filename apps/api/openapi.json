{
  "openapi": "3.0.0",
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "HealthController_verificar",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SaudeDto"
                }
              }
            }
          }
        },
        "summary": "Verificação de saúde (pública)",
        "tags": [
          "health"
        ]
      }
    },
    "/api/auth/login": {
      "post": {
        "operationId": "AuthController_login",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessaoDto"
                }
              }
            }
          },
          "401": {
            "description": "E-mail ou senha inválidos (mesma resposta nos dois casos)."
          },
          "429": {
            "description": "Mais de 5 tentativas em um minuto da mesma origem."
          }
        },
        "summary": "Entrar com e-mail e senha",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/refresh": {
      "post": {
        "operationId": "AuthController_refresh",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessaoDto"
                }
              }
            }
          },
          "401": {
            "description": "Sem cookie, ou token inválido, vencido ou já usado."
          }
        },
        "security": [
          {
            "ft_refresh": []
          }
        ],
        "summary": "Renovar a sessão (gira o token de renovação do cookie)",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/logout": {
      "post": {
        "operationId": "AuthController_logout",
        "parameters": [],
        "responses": {
          "204": {
            "description": ""
          }
        },
        "security": [
          {
            "ft_refresh": []
          }
        ],
        "summary": "Sair: revoga a sessão deste aparelho",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/me": {
      "get": {
        "operationId": "AuthController_me",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContaDto"
                }
              }
            }
          },
          "401": {
            "description": "Não autenticado."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "A conta de quem está autenticado",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/trocar-senha": {
      "post": {
        "description": "A senha vira definitiva, as outras sessões da conta caem e a resposta traz uma sessão nova.",
        "operationId": "AuthController_trocarSenha",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TrocarSenhaDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessaoDto"
                }
              }
            }
          },
          "400": {
            "description": "Senha atual incorreta, ou nova senha fora da política ou igual à atual."
          },
          "401": {
            "description": "Não autenticado."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Trocar a senha (obrigatório para conta com senha provisória)",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/alunos": {
      "post": {
        "operationId": "AlunosController_criar",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CriarAlunoDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlunoComSenhaProvisoriaDto"
                }
              }
            }
          },
          "401": {
            "description": "Não autenticado."
          },
          "403": {
            "description": "Sem permissão: só professor."
          },
          "409": {
            "description": "E-mail já cadastrado."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Criar a conta de um aluno, vinculada ao professor logado",
        "tags": [
          "alunos"
        ]
      },
      "get": {
        "operationId": "AlunosController_listar",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ContaDto"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Não autenticado."
          },
          "403": {
            "description": "Sem permissão: só professor."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Listar os alunos do professor logado",
        "tags": [
          "alunos"
        ]
      }
    },
    "/api/alunos/{id}/redefinir-senha": {
      "post": {
        "operationId": "AlunosController_redefinirSenha",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlunoComSenhaProvisoriaDto"
                }
              }
            }
          },
          "401": {
            "description": "Não autenticado."
          },
          "403": {
            "description": "Sem permissão: só professor."
          },
          "404": {
            "description": "Aluno não encontrado (inexistente ou de outro professor)."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Gerar nova senha provisória para um aluno do professor logado",
        "tags": [
          "alunos"
        ]
      }
    }
  },
  "info": {
    "title": "fininho-treino",
    "description": "API de fichas de treino: contas, acesso, fichas e sessões.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "SaudeDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          }
        },
        "required": [
          "status"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "paula@exemplo.test"
          },
          "senha": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "senha"
        ]
      },
      "Papel": {
        "type": "string",
        "enum": [
          "PROFESSOR",
          "ALUNO"
        ]
      },
      "ContaDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "nome": {
            "type": "string",
            "example": "Paula Prado"
          },
          "email": {
            "type": "string",
            "example": "paula@exemplo.test"
          },
          "papel": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Papel"
              }
            ]
          },
          "senhaProvisoria": {
            "type": "boolean",
            "description": "Verdadeiro enquanto a conta não trocou a senha provisória."
          }
        },
        "required": [
          "id",
          "nome",
          "email",
          "papel",
          "senhaProvisoria"
        ]
      },
      "SessaoDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "JWT de acesso, válido por 15 minutos. Guardar só em memória."
          },
          "usuario": {
            "$ref": "#/components/schemas/ContaDto"
          }
        },
        "required": [
          "accessToken",
          "usuario"
        ]
      },
      "TrocarSenhaDto": {
        "type": "object",
        "properties": {
          "senhaAtual": {
            "type": "string",
            "description": "A senha atual (a provisória, no primeiro acesso)."
          },
          "novaSenha": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          }
        },
        "required": [
          "senhaAtual",
          "novaSenha"
        ]
      },
      "CriarAlunoDto": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string",
            "example": "Ari Alves"
          },
          "email": {
            "type": "string",
            "example": "ari@exemplo.test"
          }
        },
        "required": [
          "nome",
          "email"
        ]
      },
      "AlunoComSenhaProvisoriaDto": {
        "type": "object",
        "properties": {
          "aluno": {
            "$ref": "#/components/schemas/ContaDto"
          },
          "senhaProvisoria": {
            "type": "string",
            "description": "Senha provisória gerada pelo sistema. Mostrada só nesta resposta; não é consultável depois.",
            "example": "abcd-efgh-jkmn"
          }
        },
        "required": [
          "aluno",
          "senhaProvisoria"
        ]
      }
    }
  }
}
