          },
          "400": {
            "description": "Ficha sem dia, ou com dia sem item."
          },
          "401": {
            "description": "Não autenticado."
          },
          "403": {
            "description": "Sem permissão: só professor."
          },
          "404": {
            "description": "Ficha não encontrada (inexistente ou de outro professor)."
          }
        },
        "security": [
