                  }
                }
              }
            }
          },
          "401": {
            "description": "Não autenticado."
          },
          "403": {
            "description": "Sem permissão: só professor."
          },
          "404": {
            "description": "Aluno não encontrado (inexistente ou de outro professor)."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Listar as fichas de um aluno do professor logado",
        "tags": [
